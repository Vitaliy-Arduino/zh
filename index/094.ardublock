                <field name="a1"></field>
                <field name="a2"></field>
                <field name="a3">void clearDisplay() {     for (int i = 0; i &lt; pixels.numPixels(); i++) {         pixels.setPixelColor(i, pixels.Color(0, 0, 0));     }     pixels.show(); }</field>
